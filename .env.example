# =============================================================================
# Faculty & Staff Attendance System — Environment Configuration
# =============================================================================
# Copy this file to `.env` and adjust the variables for your environment:
#   cp .env.example .env
#
# Running with Docker Compose:
#   docker compose up -d
#
# Running Manually (outside Docker):
#   ./run_manual.sh
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# -----------------------------------------------------------------------------
# Environment mode: `development` or `production`
# (production enforces strong secrets, hides /docs, and requires SMTP configuration)
APP_ENV=development

# Port where the application is accessible on the host (both Docker & manual mode)
APP_PORT=5860

# Base URL used for email reset links, callbacks, and frontend redirection
FRONTEND_URL=http://localhost:5860

# Allowed CORS origins (JSON array of strings)
CORS_ORIGINS=["http://localhost:5860"]

# Timezone for daily attendance boundaries and timestamp display (stored in UTC)
APP_TIMEZONE=Asia/Kolkata

# -----------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION
# -----------------------------------------------------------------------------
# Secret key for signing JWT tokens (minimum 32 characters, 64 recommended)
# Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-generate-a-64-char-random-string
JWT_ALGORITHM=HS256

# Session lifetimes in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_EXPIRE_MINUTES=30

# Allow self-registration on the sign-up page (requires `@siet.ac.in` email)
SIGNUP_ENABLED=true

# -----------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (MySQL)
# -----------------------------------------------------------------------------
# When running inside Docker Compose, host/port are overridden automatically
# with the internal `mysql:3306` service.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=staff_attendance
MYSQL_USER=staff_app
MYSQL_PASSWORD=change-me-db-password

# Root password used only when initializing the MySQL container in Docker Compose
MYSQL_ROOT_PASSWORD=change-me-root-password

# Optional: Path to custom CA certificate for SSL database connections
# MYSQL_SSL_CA=/path/to/ca.pem

# Optional: Direct database URL (overrides individual MYSQL_* settings if set)
# DATABASE_URL=mysql+pymysql://staff_app:change-me-db-password@localhost:3306/staff_attendance

# -----------------------------------------------------------------------------
# 4. IN-MEMORY CACHE & EVENT BROKER (Redis)
# -----------------------------------------------------------------------------
# Used for session verification, de-duplication, and live event pub/sub.
# (Inside Docker Compose, this is automatically routed to `redis://redis:6379/0`)
REDIS_URL=redis://localhost:6379/0
REDIS_EVENTS_CHANNEL=face_recognition_events
RECOGNITION_CACHE_TTL=5
ATTENDANCE_DEBOUNCE_TTL=60

# -----------------------------------------------------------------------------
# 5. VECTOR DATABASE (Qdrant)
# -----------------------------------------------------------------------------
# Vector store for facial embeddings (ArcFace / InsightFace / YOLO)
# (Inside Docker Compose, this is automatically routed to `http://qdrant:6333`)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=some-random-api-key
QDRANT_COLLECTION=face_embeddings
EMBEDDING_DIM=512

# -----------------------------------------------------------------------------
# 6. FACE RECOGNITION & AI INFERENCE ENGINE
# -----------------------------------------------------------------------------
# Mount inference engine directly under FastAPI at `/api/v1/inference`
INFERENCE_MOUNT_ENABLED=true

# Face detection model (auto-downloaded on first run if missing)
YOLO_FACE_MODEL=yolov8n-face.pt
DETECTION_CONF_THRESHOLD=0.5
DETECTION_IMG_SIZE=640
MAX_FACES_PER_FRAME=5

# Cosine similarity threshold for facial identification (0.0 to 1.0)
RECOGNITION_SCORE_THRESHOLD=0.55

# Number of photos required during registration/enrollment (strictly 10 photos)
FACE_ENROLL_MIN_IMAGES=10
FACE_ENROLL_MAX_IMAGES=10

# Seconds a recognized face token stays valid for check-in / check-out
FACE_VERIFY_TTL=30

# Hardware Acceleration:
# Set FORCE_CPU=true to always use CPU even if CUDA GPU is available
FORCE_CPU=false
USE_FP16=true

# -----------------------------------------------------------------------------
# 7. KIOSK MODE SETTINGS (System Role)
# -----------------------------------------------------------------------------
# The check-in kiosk remains signed in on shared terminals
KIOSK_TOKEN_EXPIRE_MINUTES=720

# Minimum face width as a fraction of the frame width (filters out background passersby)
KIOSK_MIN_FACE_RATIO=0.12

# -----------------------------------------------------------------------------
# 8. EMAIL SERVICE CONFIGURATION
# -----------------------------------------------------------------------------
# Backend: `console` (prints password resets to stdout for dev) | `smtp` (required in prod)
EMAIL_BACKEND=console
EMAIL_FROM=Faculty Attendance <no-reply@siet.ac.in>

# SMTP server settings (fill these when EMAIL_BACKEND=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=false

# -----------------------------------------------------------------------------
# 9. LOGGING & AUDIT TRAILS
# -----------------------------------------------------------------------------
# Level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Format: `auto` (json in production, readable text in dev) | `json` | `text`
LOG_FORMAT=auto

# Log storage directory outside Docker ("" = console only).
# Inside Docker, logs are written to `/var/log/staff-attendance`
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# -----------------------------------------------------------------------------
# 10. DOCKER COMPOSE DEPLOYMENT & MOUNTS
# -----------------------------------------------------------------------------
# Host paths mounted into the container (created automatically if missing)
MEDIA_HOST_DIR=./media
LOG_HOST_DIR=./logs
MYSQL_DATA_DIR=./mysql_data
QDRANT_DATA_DIR=./qdrant_data
REDIS_DATA_DIR=./redis_data

# User/Group IDs inside Linux containers to match host ownership (`id -u` / `id -g`)
APP_UID=1000
APP_GID=1000

# PyTorch wheel index for CPU builds. Leave empty to install CUDA wheels from PyPI.
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
