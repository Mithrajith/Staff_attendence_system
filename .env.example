QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=some-random-api-key
QDRANT_COLLECTION=face_embeddings
EMBEDDING_DIM=512

# Redis - pub/sub broadcast, recognition de-dupe cache, attendance debounce
REDIS_URL=redis://localhost:6379/0
REDIS_EVENTS_CHANNEL=face_recognition_events
RECOGNITION_CACHE_TTL=5
ATTENDANCE_DEBOUNCE_TTL=60

# MySQL - used by docker-compose (mysql service) and the API (api/core/config.py)
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=staff_app
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=staff_attendance

# YOLO face detector (auto-downloaded on first run if missing)
YOLO_FACE_MODEL=yolov8n-face.pt
DETECTION_CONF_THRESHOLD=0.5
DETECTION_IMG_SIZE=640
MAX_FACES_PER_FRAME=5

# Recognition
RECOGNITION_SCORE_THRESHOLD=0.55

# GPU is optional: set FORCE_CPU=true to always run on CPU regardless of CUDA availability
FORCE_CPU=false
USE_FP16=true

# ---------------------------------------------------------------------------
# User management API (uvicorn api.main:app)
# ---------------------------------------------------------------------------
# production enforces strong secrets + SMTP and hides /docs
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000"]

# MySQL (docker-compose service mysql). Or set DATABASE_URL=mysql+pymysql://user:pass@host:3306/db
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=staff_attendance
MYSQL_USER=staff_app
MYSQL_PASSWORD=change-me-db-password
# root password is only used by the docker-compose mysql service
MYSQL_ROOT_PASSWORD=change-me-root-password
# MYSQL_SSL_CA=/path/to/ca.pem

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-generate-a-64-char-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_EXPIRE_MINUTES=30

# Email: console (logs only, dev) | smtp (required in production)
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=false
EMAIL_FROM=Staff Attendance <no-reply@example.com>
FRONTEND_URL=http://localhost:8000

# Self sign-up on the web page (creates an active staff account)
SIGNUP_ENABLED=true
# Serve the inference service under /api/v1/inference (admin: everything; other users: live stream + health)
INFERENCE_MOUNT_ENABLED=true
# Photos required / accepted for face enrollment
FACE_ENROLL_MIN_IMAGES=3
FACE_ENROLL_MAX_IMAGES=10

# Attendance: work-day boundaries use this timezone (timestamps are stored in UTC)
APP_TIMEZONE=Asia/Kolkata
# Seconds a face recognition stays valid for a single check-in/check-out
FACE_VERIFY_TTL=30

# Kiosk (system role): token lifetime, min face width as a fraction of the frame
KIOSK_TOKEN_EXPIRE_MINUTES=720
KIOSK_MIN_FACE_RATIO=0.12

# ---------------------------------------------------------------------------
# Logging (api/core/logs.py)
# ---------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# auto = json in production, text otherwise | json | text
LOG_FORMAT=auto
# Where log files are written when running outside Docker ("" = console only).
# Inside Docker this is always /var/log/staff-attendance, mounted from LOG_HOST_DIR.
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# ---------------------------------------------------------------------------
# Docker deployment (docker-compose.yml)
# ---------------------------------------------------------------------------
# Inside compose, MYSQL_HOST / REDIS_URL / QDRANT_URL above are overridden with the service
# names (mysql, redis, qdrant), so the localhost values are only for running the API with `uv run`.
#
# The only port published to the host. MySQL, Redis and Qdrant are not exposed.
APP_PORT=8000
# Host directories mounted into the app container (created automatically if missing).
# Enrolled face images (media/<employee id>/...) and application logs (app/error/access/audit .log)
MEDIA_HOST_DIR=./media
LOG_HOST_DIR=./logs
# Host directories holding the databases' data
MYSQL_DATA_DIR=./mysql_data
QDRANT_DATA_DIR=./qdrant_data
REDIS_DATA_DIR=./redis_data
# Linux hosts: the container runs as this uid/gid, so MEDIA_HOST_DIR and LOG_HOST_DIR must be writable by it
# (find yours with `id -u` / `id -g`). Rebuild the image after changing.
APP_UID=1000
APP_GID=1000
# PyTorch wheel index used at build time. Default is CPU-only; set empty for the CUDA wheels from PyPI.
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
