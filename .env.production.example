# =============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION (.env.production)
# =============================================================================
# IMPORTANT: In production, the system validates that:
#   1. APP_ENV=production
#   2. JWT_SECRET_KEY is at least 32 characters and contains NO placeholders
#   3. MYSQL_PASSWORD is set and contains NO placeholders
#   4. EMAIL_BACKEND=smtp and SMTP_HOST is provided
#   5. CORS_ORIGINS contains NO wildcards (*)
#
# Generate secrets before deploying:
#   JWT_SECRET_KEY:  python -c "import secrets; print(secrets.token_urlsafe(64))"
#   MYSQL_PASSWORD:  python -c "import secrets; print(secrets.token_urlsafe(24))"
#   QDRANT_API_KEY:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# -----------------------------------------------------------------------------
APP_ENV=production
APP_PORT=5860
FRONTEND_URL=https://attendance.siet.ac.in
APP_TIMEZONE=Asia/Kolkata

# Explicit list of permitted institutional origins (NO WILDCARDS allowed in production)
CORS_ORIGINS=["https://attendance.siet.ac.in"]

# SSL / TLS Configuration
SSL_ENABLED=true
SSL_HOST_DIR=./ssl
SSL_KEYFILE=/ssl/server.key
SSL_CERTFILE=/ssl/server.crt

# -----------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION
# -----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=REPLACE_WITH_GENERATED_64_CHAR_SECRET_KEY
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_EXPIRE_MINUTES=30

# Self sign-up restricts users to emails ending in @siet.ac.in
SIGNUP_ENABLED=true

# -----------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (MySQL)
# -----------------------------------------------------------------------------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=staff_attendance
MYSQL_USER=staff_app
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
MYSQL_PASSWORD=REPLACE_WITH_STRONG_MYSQL_APP_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_STRONG_MYSQL_ROOT_PASSWORD

# Optional: Path to CA certificate for SSL encrypted MySQL connections
# MYSQL_SSL_CA=/etc/ssl/certs/rds-combined-ca-bundle.pem

# Connection pooling tuning
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=25
DB_POOL_RECYCLE=1800

# -----------------------------------------------------------------------------
# 4. IN-MEMORY CACHE & EVENT BROKER (Redis)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_EVENTS_CHANNEL=face_recognition_events
RECOGNITION_CACHE_TTL=5
ATTENDANCE_DEBOUNCE_TTL=60

# -----------------------------------------------------------------------------
# 5. VECTOR DATABASE (Qdrant)
# -----------------------------------------------------------------------------
QDRANT_URL=http://qdrant:6333
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
QDRANT_API_KEY=REPLACE_WITH_GENERATED_QDRANT_API_KEY
QDRANT_COLLECTION=face_embeddings
EMBEDDING_DIM=512

# -----------------------------------------------------------------------------
# 6. FACE RECOGNITION & AI INFERENCE ENGINE
# -----------------------------------------------------------------------------
INFERENCE_MOUNT_ENABLED=true
YOLO_FACE_MODEL=yolov8n-face.pt
DETECTION_CONF_THRESHOLD=0.5
DETECTION_IMG_SIZE=640
MAX_FACES_PER_FRAME=5
RECOGNITION_SCORE_THRESHOLD=0.55

# Enrollment limits: strictly 10 photos
FACE_ENROLL_MIN_IMAGES=10
FACE_ENROLL_MAX_IMAGES=10
FACE_VERIFY_TTL=30

# Hardware Acceleration: set FORCE_CPU=true if no GPU is available on the host
FORCE_CPU=false
USE_FP16=true

# -----------------------------------------------------------------------------
# 7. KIOSK MODE SETTINGS
# -----------------------------------------------------------------------------
KIOSK_TOKEN_EXPIRE_MINUTES=720
KIOSK_MIN_FACE_RATIO=0.12

# -----------------------------------------------------------------------------
# 8. PRODUCTION EMAIL SERVICE (SMTP is required in production)
# -----------------------------------------------------------------------------
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=attendance@siet.ac.in
SMTP_PASSWORD=REPLACE_WITH_SMTP_ACCOUNT_PASSWORD
SMTP_USE_SSL=false
EMAIL_FROM=Faculty Attendance System <attendance@siet.ac.in>

# -----------------------------------------------------------------------------
# 9. LOGGING & AUDIT TRAILS
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=/var/log/staff-attendance
LOG_MAX_BYTES=20971520
LOG_BACKUP_COUNT=15

# -----------------------------------------------------------------------------
# 10. DOCKER DEPLOYMENT DIRECTORIES
# -----------------------------------------------------------------------------
MEDIA_HOST_DIR=/var/data/staff-attendance/media
LOG_HOST_DIR=/var/log/staff-attendance
MYSQL_DATA_DIR=/var/data/staff-attendance/mysql
QDRANT_DATA_DIR=/var/data/staff-attendance/qdrant
REDIS_DATA_DIR=/var/data/staff-attendance/redis

APP_UID=1000
APP_GID=1000
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

